{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSDS",
  "version": "0.0.53",
  "identifier": "com.witchspire.wsds",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WSDS - Witchspire Dedicated Server",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "backgroundColor": "#120c1a",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing --renderer-process-limit=1 --disable-extensions --disable-background-networking --js-flags=--max-old-space-size=96"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}